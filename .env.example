# ==========================================
# 大模型配置 (以商汤日日新 SenseNova 为例，兼容 OpenAI 格式)
# ==========================================
# 必填：商汤控制台获取的 API 密钥 (https://platform.sensenova.cn)
SENSENOVA_API_KEY=your_api_key_here

# 选填：接口请求地址 (OpenAI 兼容接口统一为 https://token.sensenova.cn/v1)
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# 选填：模型名称 (例如 SenseChat-5, sensenova-6.8-flash-lite 等)
SENSENOVA_MODEL_NAME=SenseChat-5

# 选填：是否在控制台打印大模型底层的 HTTP 请求与响应报文 (排查 Agent 行为极度推荐开启)
SENSENOVA_LOG_REQUESTS=true
SENSENOVA_LOG_RESPONSES=true

# ==========================================
# 阶段 2 基础设施服务配置 (Docker Compose 预留)
# ==========================================
POSTGRES_USER=myagent
POSTGRES_PASSWORD=myagent_password
POSTGRES_DB=myagent_db
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password
